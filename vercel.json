{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "echo 'assets are built in the PHP function (composer run vercel)'",
    "buildCommand": "rm -rf .vercel-static && cp -R public .vercel-static && rm -rf .vercel-static/index.php .vercel-static/.htaccess .vercel-static/hot .vercel-static/build",
    "outputDirectory": ".vercel-static",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.php"
        }
    ]
}
