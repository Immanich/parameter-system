APP_NAME=ParaMeter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Uses DATABASE_URL (pooled). Migrate over the direct URL: php artisan migrate --database=pgsql_direct

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Neon: `neon deploy` (or `neon env pull`) writes these from neon.ts
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=

# Laravel wiring for the Neon services above
AWS_BUCKET=assets
AWS_USE_PATH_STYLE_ENDPOINT=true
VITE_NEON_AUTH_URL="${NEON_AUTH_BASE_URL}"
VITE_NEON_REALTIME_URL="${NEON_REALTIME_URL}"

VITE_APP_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@parameter.test
ADMIN_PASSWORD=password
